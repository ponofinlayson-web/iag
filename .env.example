# IAG local stack -- environment template.
# Copy to .env and fill real values:  python scripts/gen_env.py
# .env is GITIGNORED. Changing DB passwords after first boot does NOT update
# an initialized postgres volume (init scripts run only on an empty volume);
# to apply new DB passwords run: docker compose down -v   (wipes all data!)

# Superuser password for the iag_migrate Postgres role (DDL/migrations).
IAG_POSTGRES_PASSWORD=change-me-migrate-db-password

# Password for the least-privilege iag_app Postgres role (runtime DML only).
IAG_APP_DB_PASSWORD=change-me-app-db-password

# HMAC key signing session tokens. Shared by all app replicas. Min 32 chars.
IAG_SECRET_KEY=change-me-at-least-32-characters-long-secret

# Password for the first admin user created by the migrate container.
IAG_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-login-password

# Optional username override for the bootstrap admin (default: admin).
# IAG_BOOTSTRAP_ADMIN_USERNAME=admin

# ------------------------------------------------------------------
# Optional knobs. Every one of these has a baked-in default in the app
# Settings; uncomment and change only what you need. compose.yaml
# forwards all of them, so a value set here reaches the containers.
# ------------------------------------------------------------------

# --- Email (review reminders + notify_owner remediation) ---
# Empty host (default) = log-only dev mode: nothing is sent, workers
# just log. If you set a host, USER/PASSWORD/FROM are ALL REQUIRED —
# the app fails fast at boot otherwise. Senders are adaptive: STARTTLS
# when offered (plaintext fallback with warning), AUTH only when the
# server offers it.
# IAG_SMTP_HOST=
# IAG_SMTP_PORT=587
# IAG_SMTP_USER=
# IAG_SMTP_PASSWORD=
# IAG_SMTP_FROM=

# --- Reminder email worker ---
# IAG_REMINDER_DELAY_MINUTES=60
# IAG_REMINDER_POLL_SECONDS=60
# IAG_REMINDER_MAX_ATTEMPTS=3
# IAG_REMINDER_STUCK_MINUTES=15
# IAG_REMINDER_BATCH_SIZE=25

# --- Connector sync worker ---
# IAG_CONNECTOR_POLL_SECONDS=60
# IAG_CONNECTOR_STUCK_MINUTES=15
# IAG_CONNECTOR_TIMEOUT_SECONDS=30
# IAG_CONNECTOR_MAX_ROWS=50000

# --- Remediation worker ---
# IAG_REMEDIATION_POLL_SECONDS=30
# IAG_REMEDIATION_STUCK_MINUTES=15
# IAG_REMEDIATION_MAX_ATTEMPTS=3
# IAG_REMEDIATION_WEBHOOK_TIMEOUT_SECONDS=10

# --- Risk scoring ---
# IAG_RISK_UNREVIEWED_DAYS=90

# --- Sessions / auth hardening ---
# IAG_SESSION_EXPIRE_MINUTES=480
# IAG_ACCESS_TOKEN_EXPIRE_MINUTES=30
# IAG_MAX_LOGIN_ATTEMPTS=5
# IAG_LOCKOUT_DURATION_MINUTES=15

# --- Misc ---
# Public base URL used in review links inside reminder emails.
# IAG_APP_BASE_URL=http://localhost:8090
# Extra CORS origins (comma-separated) if serving the UI elsewhere.
# IAG_CORS_ORIGINS=
